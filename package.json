{
    "name": "@hlf-core/transport",
    "version": "3.2.10",
    "description": "TypeScript library for Hyperledger Fabric client transport: command sending, block and event parsing, batch delivery and chaincode error handling",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@hlf-core/api": "~3.1.4",
        "@hlf-core/transport-common": "~3.0.15"
    },
    "devDependencies": {
        "@types/node": "^14.18.12",
        "gulp-npm-module-publisher": "~3.0.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/hlf-core-chaincode.git"
    },
    "keywords": [
        "hyperledger",
        "hyperledger-fabric",
        "fabric",
        "transport",
        "blockchain",
        "distributed-ledger",
        "block-parser",
        "chaincode",
        "typescript"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/hlf-core-chaincode/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/hlf-core-chaincode#readme"
}
